import { useEffect, useRef, useState } from 'react';

export default function CuteBadmintonGame() {
  const canvasRef = useRef(null);

  const [selectedCharacter, setSelectedCharacter] = useState(null);
  const [score, setScore] = useState(0);
  const [bestScore, setBestScore] = useState(0);

  const characters = {
    kitty: {
      name: '고슈냥',
      emoji: '🎀',
      color: '#F472B6'
    },
    kuromi: {
      name: '기므네',
      emoji: '🖤',
      color: '#8B5CF6'
    },
    melody: {
      name: '신윤굥',
      emoji: '🐰',
      color: '#FB7185'
    },
    cinnamoroll: {
      name: '시나모롤',
      emoji: '☁️',
      color: '#38BDF8'
    }
  };

  useEffect(() => {
    if (!selectedCharacter) return;

    const canvas = canvasRef.current;
    const ctx = canvas.getContext('2d');

    canvas.width = 900;
    canvas.height = 550;

    let animationId;

    const player = {
      x: 180,
      y: 410,
      radius: 38,
      swing: false
    };

    const shuttle = {
      x: 650,
      y: 180,
      radius: 12,
      vx: -5,
      vy: 2,
      gravity: 0.18
    };

    const current = characters[selectedCharacter];

    function drawBackground() {
      const gradient = ctx.createLinearGradient(0, 0, 0, canvas.height);
      gradient.addColorStop(0, '#93C5FD');
      gradient.addColorStop(1, '#E0F2FE');

      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      ctx.fillStyle = '#86EFAC';
      ctx.fillRect(0, 470, canvas.width, 80);

      ctx.strokeStyle = 'white';
      ctx.lineWidth = 5;

      ctx.beginPath();
      ctx.moveTo(0, 470);
      ctx.lineTo(canvas.width, 470);
      ctx.stroke();

      ctx.fillStyle = '#E5E7EB';
      ctx.fillRect(445, 240, 10, 230);
    }

    function drawPlayer() {
      ctx.fillStyle = current.color;

      ctx.beginPath();
      ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = 'white';
      ctx.font = '40px serif';
      ctx.fillText(current.emoji, player.x - 18, player.y + 14);

      const racketX = player.swing ? player.x + 80 : player.x + 55;
      const racketY = player.swing ? player.y - 70 : player.y - 40;

      ctx.strokeStyle = '#111827';
      ctx.lineWidth = 6;

      ctx.beginPath();
      ctx.moveTo(player.x + 20, player.y - 10);
      ctx.lineTo(racketX, racketY);
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(racketX, racketY, 24, 0, Math.PI * 2);
      ctx.stroke();

      return { racketX, racketY };
    }

    function drawShuttle() {
      ctx.fillStyle = 'white';

      ctx.beginPath();
      ctx.arc(shuttle.x, shuttle.y, shuttle.radius, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#CBD5E1';

      ctx.beginPath();
      ctx.moveTo(shuttle.x - 6, shuttle.y + 8);
      ctx.lineTo(shuttle.x + 6, shuttle.y + 8);
      ctx.lineTo(shuttle.x, shuttle.y + 20);
      ctx.fill();
    }

    function resetShuttle(direction = -1) {
      shuttle.x = direction === -1 ? 650 : 250;
      shuttle.y = 180;
      shuttle.vx = direction * 5;
      shuttle.vy = 1;
    }

    function update() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      drawBackground();

      const { racketX, racketY } = drawPlayer();

      drawShuttle();

      shuttle.x += shuttle.vx;
      shuttle.y += shuttle.vy;
      shuttle.vy += shuttle.gravity;

      if (shuttle.y <= 0) {
        shuttle.vy *= -1;
      }

      if (shuttle.x >= canvas.width - 20) {
        shuttle.vx = -8;
        shuttle.vy = -6;
      }

      if (shuttle.x <= 20) {
        shuttle.vx = 0;
        shuttle.vy = 2;

        shuttle.x = 120;
        shuttle.y = 260;
      }

      const dx = shuttle.x - racketX;
      const dy = shuttle.y - racketY;
      const distance = Math.sqrt(dx * dx + dy * dy);

      if (player.swing && distance < 75) {
        const powerX = Math.max(8, Math.abs((racketX - shuttle.x) * 0.4));
        const powerY = Math.max(7, Math.abs((racketY - shuttle.y) * 0.25));

        shuttle.vx = powerX;
        shuttle.vy = -powerY;

        shuttle.x = racketX + 45;
        shuttle.y = racketY - 15;

        setScore((prev) => {
          const next = prev + 1;
          setBestScore((best) => Math.max(best, next));
          return next;
        });
      }

      /* 상대방 자동 리턴 */
      if (shuttle.x > 760 && shuttle.vx > 0) {
        shuttle.vx = -8;
        shuttle.vy = -6;

        shuttle.x = 760;
      }

      if (shuttle.y > 500) {
        shuttle.vx = 0;
        shuttle.vy = 2;

        shuttle.x = 140;
        shuttle.y = 240;
      }

      ctx.fillStyle = '#111827';
      ctx.font = 'bold 32px sans-serif';
      ctx.fillText(`🏸 SCORE ${score}`, 30, 50);

      animationId = requestAnimationFrame(update);
    }

    function handleMouseMove(e) {
      const rect = canvas.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;

      player.x = Math.max(60, Math.min(mouseX, 360));
    }

    function handleClick() {
      player.swing = true;

      setTimeout(() => {
        player.swing = false;
      }, 140);
    }

    canvas.addEventListener('mousemove', handleMouseMove);
    canvas.addEventListener('click', handleClick);

    update();

    return () => {
      cancelAnimationFrame(animationId);
      canvas.removeEventListener('mousemove', handleMouseMove);
      canvas.removeEventListener('click', handleClick);
    };
  }, [selectedCharacter]);

  if (!selectedCharacter) {
    return (
      <div className="min-h-screen bg-gradient-to-b from-pink-100 via-violet-100 to-blue-100 flex items-center justify-center p-8">
        <div className="max-w-6xl w-full">
          <div className="text-center mb-12">
            <h1 className="text-6xl font-black text-pink-500">
              뚠뚠 배드민턴 🏸
            </h1>

            <p className="mt-5 text-slate-600 text-xl font-semibold">
              캐릭터를 선택하세요!
            </p>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-7">
            {Object.entries(characters).map(([key, char]) => (
              <button
                key={key}
                onClick={() => setSelectedCharacter(key)}
                className="bg-white/70 rounded-[40px] p-8 shadow-2xl hover:scale-105 transition-all"
              >
                <div
                  className="w-40 h-40 mx-auto rounded-full flex items-center justify-center text-7xl"
                  style={{ background: char.color }}
                >
                  {char.emoji}
                </div>

                <h2 className="mt-8 text-3xl font-black text-slate-800">
                  {char.name}
                </h2>
              </button>
            ))}
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gradient-to-b from-pink-100 to-blue-100 flex flex-col items-center justify-center p-6 overflow-hidden">
      <div className="mb-6 text-center">
        <h1 className="text-5xl font-black text-pink-500">
          뚠뚠 배드민턴 🏸
        </h1>

        <p className="mt-4 text-slate-600 text-lg font-semibold">
          마우스로 이동 · 클릭으로 스매시!
        </p>
      </div>

      <div className="bg-white/70 rounded-[40px] shadow-2xl p-5 border-4 border-white relative overflow-hidden">
        <canvas
          ref={canvasRef}
          className="rounded-[30px] bg-sky-100"
        />

        <div className="absolute top-5 right-5 bg-white rounded-3xl px-6 py-4 shadow-lg">
          <div className="text-slate-400 text-sm font-bold">
            BEST SCORE
          </div>

          <div className="text-3xl font-black text-pink-500 mt-1">
            {bestScore}
          </div>
        </div>
      </div>
    </div>
  );
}
